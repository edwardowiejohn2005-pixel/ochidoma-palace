# Copy to .env for local development. Never commit the real .env file.

APP_ENV=development
PORT=8080

# postgres://user:password@host:port/dbname?sslmode=disable
DATABASE_URL=postgres://ochidoma:ochidoma@localhost:5432/ochidoma?sslmode=disable

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-real-32-plus-char-secret
JWT_REFRESH_SECRET=replace-with-a-different-32-plus-char-secret

MEDIA_STORAGE_PATH=./media

# Comma-separated list of frontend origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500
